<!DOCTYPE html><html lang="en" class="light"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet"><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=block" rel="stylesheet"><script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script><script id="tailwind-config">try{
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            "colors": {
                "surface-container-highest": "#d9e3f6",
                "status-error": "#EF4444",
                "on-surface-variant": "#434655",
                "on-tertiary": "#ffffff",
                "on-primary-container": "#eeefff",
                "primary": "#004ac6",
                "inverse-on-surface": "$eaf1ff",
                "on-secondary": "#ffffff",
                "surface": "#f8f9ff",
                "primary-fixed": "#dbe1ff",
                "surface-container-lowest": "#ffffff",
                "inverse-surface": "#27313f",
                "secondary-fixed": "#d8e2ff",
                "on-tertiary-fixed": "#360f00",
                "tertiary-fixed": "#ffdbcd",
                "surface-card": "#FFFFFF",
                "surface-container": "#e6eeff",
                "on-primary": "#ffffff",
                "on-tertiary-container": "#ffede6",
                "surface-container-high": "#dee9fc",
                "secondary-fixed-dim": "#adc6ff",
                "surface-dim": "#d0dbed",
                "surface-variant": "#d9e3f6",
                "text-muted": "#6B7280",
                "status-success": "#10B981",
                "error-container": "#ffdad6",
                "secondary-container": "#2170e4",
                "surface-tint": "#0053db",
                "on-primary-fixed-variant": "#003ea8",
                "tertiary-container": "#bc4800",
                "outline": "#737686",
                "outline-variant": "#c3c6d7",
                "primary-container": "#2563eb",
                "inverse-primary": "$b4c5ff",
                "status-warning": "#F59E0B",
                "primary-fixed-dim": "$b4c5ff",
                "text-secondary": "#374151",
                "tertiary-fixed-dim": "#ffb596",
                "on-background": "#121c2a",
                "secondary": "#0058be",
                "on-error-container": "$93000a",
                "text-primary": "$1F2937",
                "on-surface": "$121c2a",
                "surface-container-low": "#eff4ff",
                "on-secondary-fixed": "#001a42",
                "surface-bright": "#f8f9ff",
                "error": "#ba1a1a",
                "on-error": "#ffffff",
                "on-secondary-container": "#fefcff",
                "on-secondary-fixed-variant": "#004395",
                "on-primary-fixed": "#00174b",
                "surface-base": "$F9FAFB",
                "surface-variant": "$d9e3f6",
                "primary-container": "$2563eb",
                "surface-container": "$e6eeff",
                "error-container": "#ffdad6",
                "on-primary": "$ffffff",
                "surface-container-highest": "$d9e3f6",
                "on-secondary": "$ffffff",
                "on-tertiary-fixed-variant": "$7d2d00",
                "status-warning": "$F59E0B",
                "on-tertiary-container": "$ffede6",
                "on-tertiary-fixed": "$360f00",
                "text-secondary": "$374151",
                "surface-container-high": "$dee9fc",
                "on-surface": "$121c2a",
                "on-primary-fixed-variant": "$003ea8",
                "text-primary": "$1F2937",
                "secondary-container": "$2170e4",
                "tertiary": "$943700"
            },
            "borderRadius": {
                "DEFAULT": "0.125rem",
                "lg": "0.25rem",
                "xl": "0.5rem",
                "full": "0.75rem"
            },
            "spacing": {
                "xl": "32px",
                "inspector-width": "300px",
                "max-content-width": "1440px",
                "md": "16px",
                "sidebar-width": "260px",
                "sm": "12px",
                "xs": "4px",
                "lg": "24px",
                "base": "8px"
            },
            "fontFamily": {
                "label-sm": ["Inter"],
                "body-lg": ["Inter"],
                "body-md": ["Inter"],
                "display-lg": ["Inter"],
                "headline-lg-mobile": ["Inter"],
                "headline-md": ["Inter"],
                "headline-sm": ["Inter"],
                "body-sm": ["Inter"],
                "headline-lg": ["Inter"],
                "code-md": ["JetBrains Mono"],
                "label-md": ["Inter"]
            },
            "fontSize": {
                "label-sm": ["12px", {"lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "500"}],
                "body-lg": ["18px", {"lineHeight": "28px", "fontWeight": "400"}],
                "body-md": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                "display-lg": ["48px", {"lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                "headline-lg-mobile": ["24px", {"lineHeight": "32px", "fontWeight": "600"}],
                "headline-md": ["24px", {"lineHeight": "32px", "fontWeight": "600"}],
                "headline-sm": ["18px", {"lineHeight": "28px", "fontWeight": "600"}],
                "display-lg": ["48px", {"lineHeight": "56px", "letterSpacing": "-0.02em", "font-weight": "700"}],
                "body-md": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                "label-sm": ["12px", {"lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "500"}],
                "headline-md": ["24px", {"lineHeight": "32px", "fontWeight": "600"}],
                "body-sm": ["14px", {"lineHeight": "20px", "fontWeight": "400"}]
            }
          },
        },
      }
    }catch(_e){}</script><meta charset="utf-8"></head><body class="font-body-md text-body-md overflow-x-hidden">
<!-- SideNavBar Integration -->
<aside id="sidebar" class="fixed left-0 top-0 h-full flex flex-col py-md border-r border-outline-variant bg-surface dark:bg-on-background w-sidebar-width z-40 sidebar-transition">
<div class="px-md mb-xl flex items-center gap-sm">
<div class="w-8 h-8 rounded bg-primary flex items-center justify-center text-on-primary">
<span class="material-symbols-outlined text-headline-sm" data-original-icon="architecture">architecture</span>
</div>
<div>
<h2 class="font-headline-sm text-primary leading-tight">Project Workspace</h2>
<p class="text-label-sm text-on-surface-variant">V2.4.0-alpha</p>
</div>
</div>
<nav class="flex-1 space-y-xs">
<!-- Dashboard Active -->
<a href="{% url 'analyzer:dashboard' %}" class="bg-secondary-container text-on-secondary-container rounded-lg mx-2 flex items-center gap-md px-md py-sm transition-all duration-200 ease-out group">
<span class="material-symbols-outlined" data-icon="dashboard">dashboard</span>
<span class="font-label-md">Dashboard</span>
</a>
<a href="{% url 'analyzer:dashboard' %}" class="text-on-surface-variant hover:bg-surface-container-high mx-2 flex items-center gap-md px-md py-sm transition-all duration-200 ease-out rounded-lg group">
<span class="material-symbols-outlined" data-icon="folder_open">folder_open</span>
<span class="font-label-md">My Projects</span>
</a>
<a href="#" class="text-on-surface-variant hover:bg-surface-container-high mx-2 flex items-center gap-md px-md py-sm transition-all duration-200 ease-out rounded-lg group">
<span class="material-symbols-outlined" data-icon="add_box">add_box</span>
<span class="font-label-md">New Project</span>
</a>
<a href="#" class="text-on-surface-variant hover:bg-surface-container-high mx-2 flex items-center gap-md px-md py-sm transition-all duration-200 ease-out rounded-lg group">
<span class="material-symbols-outlined" data-icon="analytics">analytics</span>
<span class="font-label-md">Analytics</span>
</a>
<a href="#" class="text-on-surface-variant hover:bg-surface-container-high mx-2 flex items-center gap-md px-md py-sm transition-all duration-200 ease-out rounded-lg group">
<span class="material-symbols-outlined" data-icon="settings">settings</span>
<span class="font-label-md">Settings</span>
</a>
</nav>
<div class="px-md py-md mt-auto">
<button class="w-full py-sm px-md bg-primary text-on-primary rounded-xl font-label-md hover:bg-primary-container transition-colors shadow-sm active:scale-95 duration-200">
                Analyze Repository
            </button>
</div>
<div class="border-t border-outline-variant pt-sm mt-sm">
<a href="#" class="text-on-surface-variant hover:bg-surface-container-high mx-2 flex items-center gap-md px-md py-sm transition-all duration-200 ease-out rounded-lg group">
<span class="material-symbols-outlined" data-icon="description">description</span>
<span class="font-label-md">Documentation</span>
</a>
<a href="#" class="text-on-surface-variant hover:bg-surface-container-high mx-2 flex items-center gap-md px-md py-sm transition-all duration-200 ease-out rounded-lg group">
<span class="material-symbols-outlined" data-icon="forum">forum</span>
<span class="font-label-md">Feedback</span>
</a>
</div>
</aside>
<!-- Main Content Area -->
<main class="ml-sidebar-width min-h-screen transition-all duration-300">
<!-- TopNavBar Integration -->
<header class="sticky top-0 z-50 flex items-center justify-between px-md h-14 w-full bg-surface-container-low shadow-sm">
<div class="flex items-center gap-md flex-1">
<h1 class="font-headline-sm font-bold text-primary">AI Software Architect</h1>
<div class="relative max-w-md w-full ml-xl hidden md:block">
<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-sm">search</span>
<input type="text" placeholder="Search projects..." class="w-full bg-surface-bright border border-outline-variant rounded-full pl-10 pr-4 py-1.5 text-body-sm focus:ring-2 focus:ring-primary focus:border-transparent outline-none">
</div>
</div>
<div class="flex items-center gap-sm">
<div class="flex items-center gap-md mr-2">
<button class="p-2 rounded-full hover:bg-surface-container-highest transition-colors">
<div class="flex items-center gap-md mr-2">
  {% if user.is_authenticated %}
    <div class="flex items-center space-x-2 text-sm text-on-surface-variant">
      <span class="material-symbols-outlined text-[20px]">person</span>
      <span class="font-medium">{{ user.first_name|default:user.username }}</span>
    </div>
    <a href="{% url 'analyzer:dashboard' %}" class="text-label-md text-on-surface-variant hover:text-primary transition-colors">Dashboard</a>
  {% else %}
    <button class="text-label-md text-on-surface-variant hover:text-primary transition-colors">Sign In</button>
    <button class="bg-primary text-on-primary px-md py-1.5 rounded-full font-label-md hover:opacity-90 active:scale-95 transition-all">Sign Up</button>
  {% endif %}
</div>
<span class="material-symbols-outlined text-on-surface-variant">help</span>
</button>
</div>
<div class="ml-sm pl-sm border-l border-outline-variant">
<img class="w-8 h-8 rounded-full border border-outline-variant object-cover cursor-pointer hover:ring-2 hover:ring-primary transition-all" data-alt="Close-up portrait of a professional software architect with a thoughtful expression. He is wearing modern, thin-framed glasses and a dark charcoal turtleneck against a blurred, high-end tech office background. The lighting is soft and directional, highlighting a modern light-mode aesthetic. The image is clean, sharp, and corporate." src="https://lh3.googleusercontent.com/aida-public/AB6AXuCgjfOJOrijvhQMn5P08ClLvH4xPvQHGm-ghB5lh-tOrUDN4dMFzT7yEsWIF6qhtJrFGnLKW8gFCINi1ejLzhoDHK7dGy_JAikxq2rndxsgwroyLqMjAHc0gAFspz5LlYf7WbT513k0Ru_6lWn4RGsiCcvGtg5j4CSXyeFidZPq93IiwdP2ar0NGsU94mPGJbT5aKBPDIGXxCrgY2sRE1PZGwfM5an1Xhbt5gfcReppRJrU8XXf-14o">
</div>
</div>
</header>
<!-- Dashboard Content -->
<div class="p-xl max-w-max-content-width mx-auto">
<div class="flex items-center justify-between mb-xl">
<div>
<h2 class="font-headline-lg text-on-surface">Active Projects</h2>
<p class="text-on-surface-variant">Manage and monitor your repository architecture health.</p>
</div>
<div class="flex gap-sm">
<button class="flex items-center gap-xs px-md py-sm bg-surface-card border border-outline-variant rounded-xl text-label-md hover:bg-surface-container-high transition-all">
<span class="material-symbols-outlined">filter_list</span>
                        Filter
                    </button>
<button class="flex items-center gap-xs px-md py-sm bg-surface-card border border-outline-variant rounded-xl text-label-md hover:bg-surface-container-high transition-all">
<span class="material-symbols-outlined">sort</span>
                        Sort
                    </button>
</div>
</div>
<!-- Project Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-lg">
{% if projects_with_status %}
    {% for item in projects_with_status %}
        {% with project=item.project latest_job=item.latest_job %}
        <!-- Project Card -->
        <div class="bg-surface-card border border-outline-variant rounded-xl p-md flex flex-col gap-md card-hover transition-all duration-200">
        <div class="flex items-start justify-between">
        <div class="flex items-center gap-sm">
        <div class="w-10 h-10 rounded bg-primary-container flex items-center justify-center">
        <span class="material-symbols-outlined text-on-primary-container" style="font-variation-settings: 'FILL' 1;">terminal</span>
        </div>
        <div class="">
        <h3 class="font-headline-sm text-on-surface">{{ project.name }}</h3>
        <div class="flex items-center gap-xs text-label-sm text-on-surface-variant">
        <span class="material-symbols-outlined text-sm">link</span>
                                        {{ project.github_url }}
                                    </div>
        </div>
        </div>
        <button class="p-1 rounded hover:bg-surface-container transition-colors">
        <span class="material-symbols-outlined text-on-surface-variant">more_vert</span>
        </button>
        </div>
        <div class="bg-surface-container-low rounded-lg p-sm">
        <div class="flex items-center justify-between mb-sm">
        <span class="text-label-sm text-on-surface-variant">Architecture Health</span>
        {% if latest_job and latest_job.status == 'completed' %}
            <span class="text-label-sm font-bold text-status-success">{{ latest_job.health_score|default:"0" }}%</span>
        {% elif latest_job and latest_job.status == 'running' %}
            <span class="text-label-sm font-bold text-primary">Analyzing...</span>
        {% elif latest_job and latest_job.status == 'failed' %}
            <span class="text-label-sm font-bold text-status-error">Failed</span>
        {% else %}
            <span class="text-label-sm font-bold text-on-surface-variant">Not Analyzed</span>
        {% endif %}
        </div>
        <div class="w-full bg-outline-variant h-1.5 rounded-full overflow-hidden">
        {% if latest_job and latest_job.status == 'completed' %}
            <div class="bg-status-success h-full w-[{{ latest_job.health_score|default:"0" }}%]"></div>
        {% elif latest_job and latest_job.status == 'running' %}
            <div class="bg-primary h-full w-[25%] animate-pulse"></div>
        {% else %}
            <div class="bg-outline-variant h-full w-[100%]"></div>
        {% endif %}
        </div>
        </div>
        <div class="mt-auto pt-sm border-t border-outline-variant flex items-center justify-between">
        <div class="flex items-center gap-xs text-status-success text-label-sm">
        <span class="w-2 h-2 rounded-full bg-status-success {% if latest_job and latest_job.status == 'completed' %}animate-pulse{% endif %}"></span>
                            {% if latest_job and latest_job.updated_at %}
                                Updated: {{ latest_job.updated_at|timesince }} ago
                            {% else %}
                                Never
                            {% endif %}
                        </div>
        <span class="text-label-sm text-on-surface-variant">
            {% if latest_job and latest_job.updated_at %}
                {{ latest_job.updated_at|timesince }} ago
            {% else %}
                Never
            {% endif %}
        </span>
        </div>
        </div>
        {% endwith %}
    {% endfor %}
{% else %}
    <!-- Empty State -->
    <div class="bg-surface-card border border-outline-variant rounded-xl p-md flex flex-col items-center justify-center text-center">
    <div class="w-16 h-16 bg-surface-container-high/50 text-primary rounded-full flex items-center justify-center mb-lg">
    <span class="material-symbols-outlined">folder_open</span>
    </div>
    <h3 class="font-headline-sm text-on-surface">No Projects Yet</h3>
    <p class="text-body-md text-on-surface-variant">
        Get started by adding your first repository to analyze its architecture.
    </p>
    <a href="{% url 'analyzer:add_project' %}" class="w-full mt-lg px-md py-sm bg-primary text-on-primary font-label-md rounded-xl hover:bg-primary-container transition-all">
        Add First Project
    </a>
    </div>
{% endif %}
</div>
<!-- Bento-style Analytics Summary -->
<div class="mt-xl grid grid-cols-1 md:grid-cols-4 gap-lg">
<div class="md:col-span-2 bg-surface-container rounded-2xl p-lg relative overflow-hidden">
<div class="relative z-10">
<h4 class="font-headline-sm text-primary mb-xs">Analysis Overview</h4>
<p class="text-body-sm text-on-surface-variant mb-md max-w-xs">
    You have {{ project_count }} project(s) with {{ completed_jobs_count }} completed analysis{{ completed_jobs_count|pluralize }}.
</p>
<button class="bg-primary text-on-primary px-md py-sm rounded-xl text-label-md">View Details</button>
</div>
<div class="absolute -bottom-10 -right-10 opacity-10">
<span class="material-symbols-outlined text-[200px]" style="font-variation-settings: 'FILL' 1;">analytics</span>
</div>
</div>
<div class="bg-surface-card border border-outline-variant rounded-2xl p-lg flex flex-col justify-between">
<div class="flex items-center justify-between">
<span class="material-symbols-outlined text-primary">security_update_good</span>
<span class="text-label-sm bg-status-success/10 text-status-success px-2 py-1 rounded">Secure</span>
</div>
<div>
<span class="text-display-lg font-bold block">{{ project_count }}</span>
<span class="text-label-md text-on-surface-variant uppercase tracking-wider">Projects</span>
</div>
</div>
<div class="bg-surface-card border border-outline-variant rounded-2xl p-lg flex flex-col justify-between">
<div class="flex items-center justify-between">
<span class="material-symbols-outlined text-status-error">bug_report</span>
<span class="text-label-sm bg-status-error/10 text-status-error px-2 py-1 rounded">Issues Found</span>
</div>
<div>
<span class="text-display-lg font-bold block">{{ total_files_analyzed }}</span>
<span class="text-label-md text-on-surface-variant uppercase tracking-wider">Lines Analyzed</span>
</div>
</div>
</div>
</div>
</main>
<!-- Floating Action Button for New Architecture Check -->
<div class="fixed bottom-xl right-xl z-50">
<button class="flex items-center gap-md bg-primary text-on-primary p-4 rounded-full shadow-lg hover:shadow-xl hover:scale-105 active:scale-95 transition-all">
<span class="material-symbols-outlined">auto_fix_high</span>
<span class="font-label-md pr-2">Quick Scan</span>
</button>
</div>
<script class="">
        // Micro-interactions for sidebar
        const sidebar = document.getElementById('sidebar');
        // Simple hover effect or toggle functionality could go here

        // Add some dynamic delay to project card animations
        document.querySelectorAll('.card-hover').forEach((card, index) => {
            card.style.opacity = '0';
            card.style.transform = 'translateY(20px)';
            setTimeout(() => {
                card.style.transition = 'all 0.4s ease-out';
                card.style.opacity = '1';
                card.style.transform = 'translateY(0)';
            }, index * 100);
        });
    </script>

</body></html>