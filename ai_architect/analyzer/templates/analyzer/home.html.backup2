</div>
<!-- Step 2 -->
<div class="flex flex-col items-center text-center animate-fade-in-up" style="animation-delay: 0.2s">
<div class="w-16 h-16 rounded-full bg-primary text_on-primary flex items-center justify-center font-bold text-xl mb-md shadow-lg transform hover:scale-110 transaction-transform">2</div>
<h4 class="font-headline-sm text-headline-sm text-on-background mb-xs">AI Indexing</h4>
