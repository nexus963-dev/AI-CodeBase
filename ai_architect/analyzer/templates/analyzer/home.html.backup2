<!DOCTYPE html>
{% load static %}

<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>AI Software Architect - Intelligent Codebase Understanding</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
<!-- Tailwind Configuration -->
<script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            "colors": {
                    "secondary-container": "#2170e4",
                    "on-tertiary-fixed-variant": "#7d2d00",
                    "primary": "#004ac6",
                    "on-secondary-fixed": "#001a42",
                    "on-tertiary-container": "#ffede6",
                    "status-warning": "#F59E0B",
                    "surface": "#f8f9ff",
                    "on-primary-fixed": "#00174b",
                    "inverse-surface": "#27313f",
                    "secondary-fixed-dim": "#adc6ff",
                    "on-tertiary-fixed": "#360f00",
                    "error": "#ba1a1a",
                    "surface-variant": "#d9e3f6",
                    "surface-bright": "#f8f9ff",
                    "inverse-primary": "#b4c5ff",
                    "text-primary": "#1F2937",
                    "tertiary-fixed-dim": "#ffb596",
                    "error-container": "#ffdad6",
                    "on-error": "#ffffff",
                    "on-primary": "#ffffff",
                    "secondary-fixed": "#d8e2ff",
                    "tertiary-container": "#bc4800",
                    "on-surface": "#121c2a",
                    "primary-fixed": "#dbe1ff",
                    "surface-dim": "#d0dbed",
                    "primary-container": "#2563eb",
                    "text-secondary": "#374151",
                    "tertiary": "#943700",
                    "surface-card": "#FFFFFF",
                    "surface-tint": "#0053db",
                    "on-secondary": "#ffffff",
                    "inverse-on-surface": "#eaf1ff",
                    "on-surface-variant": "#434655",
                    "surface-base": "#F9FAFB",
                    "on-background": "#121c2a",
                    "on-secondary-fixed-variant": "#004395",
                    "text-muted": "#6B7280",
                    "on-error-container": "#93000a",
                    "primary-fixed-dim": "#b4c5ff",
                    "outline": "#737686",
                    "background": "#f8f9ff",
                    "on-primary-fixed-variant": "#003ea8",
                    "outline-variant": "#c3c6d7",
                    "on-tertiary": "#ffffff",
                    "on-primary-container": "#eeefff",
                    "status-success": "#10B981",
                    "surface-container-highest": "#d9e3f6",
                    "tertiary-fixed": "#ffdbcd",
                    "surface-container": "#e6eeff",
                    "surface-container-low": "#eff4ff",
                    "status-error": "#EF4444",
                    "secondary": "#0058be",
                    "surface-container-high": "#dee9fc",
                    "on-secondary-container": "#fefcff",
                    "surface-container-lowest": "#ffffff"
            },
            "borderRadius": {
                    "DEFAULT": "0.125rem",
                    "lg": "0.25rem",
                    "xl": "0.5rem",
                    "full": "0.75rem"
            },
            "spacing": {
                    "xs": "4px",
                    "lg": "24px",
                    "max-content-width": "1440px",
                    "inspector-width": "300px",
                    "md": "16px",
                    "base": "8px",
                    "xl": "32px",
                    "sm": "12px",
                    "sidebar-width": "260px"
            },
            "fontFamily": {
                    "body-lg": ["Inter"],
                    "headline-sm": ["Inter"],
                    "headline-lg-mobile": ["Inter"],
                    "label-sm": ["Inter"],
                    "headline-md": ["Inter"],
                    "body-sm": ["Inter"],
                    "display-lg": ["Inter"],
                    "headline-lg": ["Inter"],
                    "label-md": ["Inter"],
                    "body-md": ["Inter"],
                    "code-md": ["JetBrains Mono"]
            },
            "fontSize": {
                    "body-lg": ["18px", {"lineHeight": "28px", "fontWeight": "400"}],
                    "headline-sm": ["18px", {"lineHeight": "28px", "fontWeight": "600"}],
                    "headline-lg-mobile": ["24px", {"lineHeight": "32px", "fontWeight": "600"}],
                    "label-sm": ["12px", {"lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "500"}],
                    "headline-md": ["24px", {"lineHeight": "32px", "fontWeight": "600"}],
                    "body-sm": ["14px", {"lineHeight": "20px", "fontWeight": "400"}],
                    "display-lg": ["48px", {"lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                    "headline-lg": ["32px", {"lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "600"}],
                    "label-md": ["14px", {"lineHeight": "20px", "letterSpacing": "0.01em", "fontWeight": "500"}],
                    "body-md": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                    "code-md": ["14px", {"lineHeight": "22px", "fontWeight": "400"}]
            },
            "animation": {
              "fade-in-up": "fadeInUp 0.6s ease-out forwards",
              "code-hover": "codeHover 0.4s ease-out forwards"
            },
            "keyframes": {
              "fadeInUp": {
                "0%": { opacity: "0", transform: "translateY(20px)" },
                "100%": { opacity: "1", transform: "translateY(0)" }
              },
              "codeHover": {
                "0%": { transform: "scale(1)" },
                "100%": { transform: "scale(1.02) translateY(-4px)" }
              }
            }
          },
        },
      }
    </script>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .hero-gradient {
            background: radial-gradient(circle at 50% -20%, #e6eeff 0%, #f8f9ff 100%);
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.4);
        }
        .animate-float {
            animation: float 6s ease-in-out infinite;
        }
        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
            100% { transform: translateY(0px); }
        }
        .code-container:hover {
            box-shadow: 0 20px 40px -10px rgba(0, 74, 198, 0.2);
        }
        .hero-animation-layer {
            position: absolute;
            inset: 0;
            z-index: 0;
            opacity: 0.4;
            pointer-events: none;
        }
    </style>
</head>
<body class="bg-background text-on-surface font-body-md selection:bg-primary-fixed selection:text-on-primary-fixed">
<!-- TopNavBar (Shared Component) -->
<header class="sticky top-0 z-50 flex items-center justify-between px-md h-14 w-full bg-surface-container-low shadow-sm border-b border-outline-variant">
<div class="flex items-center gap-base">
<span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">architecture</span>
<span class="text-headline-sm font-headline-sm font-bold text-primary">AI Software Architect</span>
</div>
<div class="hidden md:flex items-center gap-lg">
<a class="text-primary font-bold border-b-2 border-primary font-label-md text-label-md py-1" href="#">Home</a>
<a class="text-on-surface-variant hover:bg-surface-container-highest transition-colors font-label-md text-label-md py-1 px-2 rounded" href="#">Features</a>
<a class="text-on-surface-variant hover:bg-surface-container-highest transition-colors font-label-md text-label-md py-1 px-2 rounded" href="#">Pricing</a>
</div>
<div class="flex items-center gap-md">
<button class="flex items-center justify-center text-on-surface-variant hover:bg-surface-container-highest transition-colors p-2 rounded-full active:scale-95 duration-200" id="theme-toggle">
<span class="material-symbols-outlined" id="theme-icon">light_mode</span>
</button>
<div class="h-6 w-[1px] bg-outline-variant mx-1"></div>
    <!-- Messages -->
    {% if messages %}
        {% for message in messages %}
        <div class="p-3 mb-4 rounded-lg {% if message.tags == "error" %}bg-red-100 text-red-700{% elif message.tags == "success" %}bg-green-100 text-green-700{% elif message.tags == "warning" %}bg-yellow-100 text-yellow-700{% else %}bg-blue-100 text-blue-700{% endif %}">
            {{ message }}
        </div>
        {% endfor %}
    {% endif %}
<div class="flex items-center gap-sm">
<a href="{% url 'analyzer:login' %}" class="text-primary hover:bg-surface-container-highest transition-colors font-label-md text-label-md px-md py-2 rounded-xl">
                Sign In
            </a>
<a href="{% url 'analyzer:signup' %}" class="bg-primary text-on-primary font-label-md text-label-md px-lg py-2 rounded-xl hover:bg-opacity-90 active:scale-95 transition-all duration-200 shadow-sm">
    <!-- Messages -->
    {% if messages %}
        {% for message in messages %}
        <div class="p-3 mb-4 rounded-lg {% if message.tags == "error" %}bg-red-100 text-red-700{% elif message.tags == "success" %}bg-green-100 text-green-700{% elif message.tags == "warning" %}bg-yellow-100 text-yellow-700{% else %}bg-blue-100 text-blue-700{% endif %}">
            {{ message }}
        </div>
        {% endfor %}
    {% endif %}
                Sign Up
            </a>
</div>
</div>
</header>
